{
  "openapi": "3.1.1",
  "info": {
    "title": "FoodExpress.Server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:50394"
    },
    {
      "url": "http://localhost:50395"
    }
  ],
  "paths": {
    "/api/restaurants": {
      "get": {
        "tags": [
          "FoodExpress.Server"
        ],
        "operationId": "GetRestaurants",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Restaurant"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": [
          "FoodExpress.Server"
        ],
        "operationId": "PlaceOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderRequest": {
        "required": [
          "restaurantId",
          "items"
        ],
        "type": "object",
        "properties": {
          "restaurantId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Restaurant": {
        "required": [
          "id",
          "name",
          "cuisine",
          "rating"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "cuisine": {
            "type": "string"
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "FoodExpress.Server"
    }
  ]
}